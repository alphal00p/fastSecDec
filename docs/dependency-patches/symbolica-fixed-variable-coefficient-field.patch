diff --git a/tests/coefficient_field_conversion.rs b/tests/coefficient_field_conversion.rs
new file mode 100644
index 00000000..f0332a1f
--- /dev/null
+++ b/tests/coefficient_field_conversion.rs
@@ -0,0 +1,47 @@
+use symbolica::{atom::AtomCore, domains::atom::AtomField, parse, symbol};
+
+fn exact_field() -> AtomField {
+    AtomField {
+        statistical_zero_test: false,
+        ..AtomField::new()
+    }
+}
+
+#[test]
+fn fixed_variable_conversion_preserves_compact_coefficients() {
+    let expression = parse!("(t*(x+y))^10000");
+    let polynomial =
+        expression.to_polynomial_in_vars_with_field::<u32>(symbol!("t"), &exact_field());
+    assert_eq!(polynomial.nvars(), 1);
+    assert_eq!(polynomial.nterms(), 1);
+    let term = (&polynomial).into_iter().next().unwrap();
+    assert_eq!(term.exponents, &[10000]);
+    assert_eq!(term.coefficient, &parse!("(x+y)^10000"));
+    assert!(!polynomial.ring().statistical_zero_test);
+}
+
+#[test]
+fn exact_field_retains_unresolved_cancellation_and_nonhomogeneous_terms() {
+    let expression = parse!("t*(x+y)+t^2*(x^2-y^2-(x-y)*(x+y))");
+    let polynomial =
+        expression.to_polynomial_in_vars_with_field::<u32>(symbol!("t"), &exact_field());
+    assert_eq!(polynomial.nterms(), 2);
+    let simplified = polynomial.map_coeff(|coefficient| coefficient.expand(), exact_field());
+    assert_eq!(simplified.nterms(), 1);
+    assert_eq!((&simplified).into_iter().next().unwrap().exponents, &[1]);
+
+    let nonhomogeneous =
+        parse!("t*x+t^2*y").to_polynomial_in_vars_with_field::<u32>(symbol!("t"), &exact_field());
+    assert_eq!(nonhomogeneous.nterms(), 2);
+}
+
+#[test]
+fn default_conversion_keeps_its_existing_coefficient_policy() {
+    let expression = parse!("(t+x)^3+f(y)*t+1");
+    let existing = expression.to_polynomial_in_vars::<u32>(symbol!("t"));
+    let explicit =
+        expression.to_polynomial_in_vars_with_field::<u32>(symbol!("t"), &AtomField::new());
+    assert!(existing.ring().statistical_zero_test);
+    assert_eq!(existing, explicit);
+    assert_eq!(existing.flatten(false), explicit.flatten(false));
+}
