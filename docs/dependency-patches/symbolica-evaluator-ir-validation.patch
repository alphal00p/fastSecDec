+#[test]
+fn native_branch_nested_zero_argument_and_evaluated_stacks_roundtrip() {
+    let expressions = [
+        crate::parse!("if(x,ir_valid::outer(x),ir_valid::zero())"),
+        crate::parse!("x+3"),
+    ];
+    let parameters = [crate::parse!("x"), crate::parse!("q")];
+    let exact = Atom::evaluator_multiple(&expressions, &parameters)
+        .add_function_with_options(
+            crate::symbol!("ir_valid::inner"),
+            vec![crate::symbol!("z")],
+            crate::parse!("z^2"),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .add_function_with_options(
+            crate::symbol!("ir_valid::outer"),
+            vec![crate::symbol!("z")],
+            crate::parse!("ir_valid::inner(z)+q"),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .add_function_with_options(
+            crate::symbol!("ir_valid::zero"),
+            Vec::<Symbol>::new(),
+            crate::parse!("q+1"),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    exact.validate_structure().unwrap();
+    let mut evaluator = exact.map_coeff(&|c| c.re.to_f64());
+    let mut values = [0.; 2];
+    evaluator.evaluate(&[2., 7.], &mut values);
+    assert_eq!(values, [11., 5.]);
+    evaluator.validate_structure().unwrap(); // Populated native body stacks.
+    evaluator.evaluate(&[0., 7.], &mut values);
+    assert_eq!(values, [8., 3.]);
+    #[cfg(feature = "bincode")]
+    {
+        let bytes = bincode::encode_to_vec(&evaluator, bincode::config::standard()).unwrap();
+        let (mut decoded, used): (ExpressionEvaluator<f64>, _) =
+            bincode::decode_from_slice(&bytes, bincode::config::standard()).unwrap();
+        assert_eq!(used, bytes.len());
+        decoded.validate_structure().unwrap();
+        decoded.evaluate(&[2., 7.], &mut values);
+        assert_eq!(values, [11., 5.]);
+    }
+    let empty = ExpressionEvaluator::<f64> {
+        stack: vec![],
+        param_count: 0,
+        reserved_indices: 0,
+        instructions: vec![],
+        result_indices: vec![],
+        external_fns: vec![],
+        settings: OptimizationSettings::default(),
+    };
+    empty.validate_structure().unwrap();
+}
