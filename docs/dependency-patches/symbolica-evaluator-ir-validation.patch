+use super::*;
+
+fn simple() -> ExpressionEvaluator<f64> {
+    ExpressionEvaluator {
+        stack: vec![0., 0., 0.],
+        param_count: 1,
+        reserved_indices: 1,
+        instructions: vec![(Instr::Add(1, vec![0, 0]), ComplexPhase::Any)],
+        result_indices: vec![1],
+        external_fns: vec![],
+        settings: OptimizationSettings::default(),
+    }
+}
+
+fn reject(evaluator: ExpressionEvaluator<f64>) {
+    assert!(evaluator.validate_structure().is_err());
+    // Serializing malformed test data is safe. Never evaluate or export it.
+    #[cfg(feature = "bincode")]
+    {
+        let bytes = bincode::encode_to_vec(&evaluator, bincode::config::standard()).unwrap();
+        assert!(
+            bincode::decode_from_slice::<ExpressionEvaluator<f64>, _>(
+                &bytes,
+                bincode::config::standard(),
+            )
+            .is_err()
+        );
+        assert!(
+            bincode::borrow_decode_from_slice::<ExpressionEvaluator<f64>, _>(
+                &bytes,
+                bincode::config::standard(),
+            )
+            .is_err()
+        );
+    }
+}
+
+#[test]
+fn malformed_root_layout_and_instructions_are_rejected_before_evaluation() {
+    let mut evaluator = simple();
+    evaluator.param_count = 2;
+    reject(evaluator);
+    let mut evaluator = simple();
+    evaluator.reserved_indices = 4;
+    reject(evaluator);
+    let mut evaluator = simple();
+    evaluator.result_indices = vec![3];
+    reject(evaluator);
+    let invalid = [
+        Instr::Add(1, vec![]),
+        Instr::Mul(1, vec![]),
+        Instr::Add(3, vec![0]),
+        Instr::Mul(1, vec![3]),
+        Instr::Add(0, vec![0]),
+        Instr::Pow(3, 0, 2),
+        Instr::Pow(1, 3, 2),
+        Instr::Powf(1, 0, 3),
+        Instr::Powf(0, 1, 1),
+        Instr::BuiltinFun(1, Symbol::EXP, 3),
+        Instr::BuiltinFun(1, crate::symbol!("invalid_ir::unknown"), 0),
+        Instr::ExternalFun(1, 0, vec![0]),
+        Instr::IfElse(3, Label(2)),
+        Instr::IfElse(0, Label(99)),
+        Instr::Goto(Label(99)),
+        Instr::Goto(Label(0)),
+        Instr::Label(Label(1)),
+        Instr::Join(1, 3, 0, 0),
+        Instr::Join(1, 0, 3, 0),
+        Instr::Join(1, 0, 0, 3),
+        Instr::Join(3, 0, 0, 0),
+    ];
+    for instruction in invalid {
+        let mut evaluator = simple();
+        evaluator.instructions[0].0 = instruction;
+        reject(evaluator);
+    }
+    let mut evaluator = simple();
+    evaluator.instructions[0].1 = ComplexPhase::PartialReal(3);
+    reject(evaluator);
+    let mut evaluator = simple();
+    evaluator.instructions = vec![
+        (Instr::Goto(Label(1)), ComplexPhase::Any),
+        (Instr::Add(1, vec![0]), ComplexPhase::Any),
+    ];
+    reject(evaluator); // In-range branch targets must actually be labels.
+}
+
+fn with_body() -> ExpressionEvaluator<f64> {
+    let mut evaluator = simple();
+    evaluator
+        .external_fns
+        .push(ExternalFunctionContainer::with_body(
+            crate::symbol!("invalid_ir::body"),
+            vec![],
+            Arc::new(evaluator::FunctionBody {
+                param_count: 1,
+                stack_size: 2,
+                result_index: 1,
+                instructions: vec![(Instr::Pow(1, 0, 2), ComplexPhase::Any)],
+            }),
+        ));
+    evaluator.instructions[0].0 = Instr::ExternalFun(1, 0, vec![0]);
+    evaluator
+}
+
+#[test]
+fn malformed_function_bodies_calls_and_constant_bindings_are_rejected() {
+    for mutation in 0..7 {
+        let mut evaluator = with_body();
+        let body = Arc::make_mut(evaluator.external_fns[0].body.as_mut().unwrap());
+        match mutation {
+            0 => body.param_count = 3,
+            1 => body.result_index = 2,
+            2 => body.instructions[0].0 = Instr::Mul(1, vec![]),
+            3 => body.instructions[0].0 = Instr::ExternalFun(1, 0, vec![0]),
+            4 => body.instructions[0].0 = Instr::ExternalFun(1, 1, vec![0]),
+            5 => body.instructions[0].0 = Instr::Pow(1, 99, 2),
+            6 => body.instructions[0].0 = Instr::Pow(0, 0, 2),
+            _ => unreachable!(),
+        }
+        reject(evaluator);
+    }
+    let mut evaluator = with_body();
+    evaluator.instructions[0].0 = Instr::ExternalFun(1, 0, vec![]);
+    reject(evaluator);
+    let mut evaluator = with_body();
+    evaluator.external_fns[0].stack = vec![0.];
+    // Transient worker stacks are deliberately not serialized.
+    assert!(evaluator.validate_structure().is_err());
+    let mut evaluator = with_body();
+    evaluator.external_fns[0].constant_index = Some(0);
+    reject(evaluator);
+    let mut evaluator = simple();
+    evaluator.external_fns.push(ExternalFunctionContainer::new(
+        crate::symbol!("invalid_ir::constant"),
+        vec![],
+        vec![],
+    ));
+    evaluator.external_fns[0].constant_index = Some(0);
+    reject(evaluator); // No root constant slots exist.
+}
