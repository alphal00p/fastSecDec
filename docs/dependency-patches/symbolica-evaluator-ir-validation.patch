+use super::*;
+
+impl<T> ExpressionEvaluator<T> {
+    /// Check the structural invariants needed for evaluation, conversion and export.
+    ///
+    /// Deserializers call this before exposing an evaluator. This checks indices,
+    /// instruction shapes and acyclic control/call flow; it does not certify the
+    /// mathematical expression, coefficient values or external implementations.
+    pub fn validate_structure(&self) -> Result<(), String> {
+        if self.param_count > self.reserved_indices || self.reserved_indices > self.stack.len() {
+            return Err("Invalid evaluator stack partition".into());
+        }
+        for (index, external) in self.external_fns.iter().enumerate() {
+            if let Some(constant) = external.constant_index {
+                if constant >= self.reserved_indices - self.param_count || external.body.is_some() {
+                    return Err(format!("Invalid external constant binding {index}"));
+                }
+            }
+            if let Some(body) = &external.body {
+                if body.param_count > body.stack_size
+                    || (!external.stack.is_empty() && external.stack.len() < body.stack_size)
+                {
+                    return Err(format!("Invalid function stack {index}"));
+                }
+                validate_program(
+                    &body.instructions,
+                    body.param_count,
+                    body.stack_size,
+                    std::slice::from_ref(&body.result_index),
+                    &self.external_fns[..index],
+                )
+                .map_err(|e| format!("Function {index}: {e}"))?;
+            }
+        }
+        validate_program(
+            &self.instructions,
+            self.reserved_indices,
+            self.stack.len(),
+            &self.result_indices,
+            &self.external_fns,
+        )
+    }
+}
+
+fn validate_program<T>(
+    instructions: &[(Instr, ComplexPhase)],
+    reserved: usize,
+    stack_size: usize,
+    results: &[usize],
+    callees: &[ExternalFunctionContainer<T>],
+) -> Result<(), String> {
+    let input = |slot: usize| {
+        if slot < stack_size {
+            Ok(())
+        } else {
+            Err(format!("Invalid stack index {slot}"))
+        }
+    };
+    let output = |slot: usize| {
+        if slot >= reserved && slot < stack_size {
+            Ok(())
+        } else {
+            Err(format!("Invalid output stack index {slot}"))
+        }
+    };
+    for &slot in results {
+        input(slot)?;
+    }
+    for (position, (instruction, phase)) in instructions.iter().enumerate() {
+        let branch = |target: usize| {
+            if target > position
+                && matches!(instructions.get(target), Some((Instr::Label(Label(label)), _)) if *label == target)
+            {
+                Ok(())
+            } else {
+                Err(format!("Invalid forward branch at instruction {position}"))
+            }
+        };
+        match instruction {
+            Instr::Add(dst, args) | Instr::Mul(dst, args) => {
+                output(*dst)?;
+                if args.is_empty() {
+                    return Err(format!("Empty operands at instruction {position}"));
+                }
+                if let ComplexPhase::PartialReal(n) = phase
+                    && *n > args.len()
+                {
+                    return Err(format!("Invalid complex phase at instruction {position}"));
+                }
+                for &arg in args {
+                    input(arg)?;
+                }
+            }
+            Instr::Pow(dst, base, _) => {
+                output(*dst)?;
+                input(*base)?;
+            }
+            Instr::Powf(dst, base, exponent) => {
+                output(*dst)?;
+                input(*base)?;
+                input(*exponent)?;
+            }
+            Instr::BuiltinFun(dst, symbol, arg) => {
+                output(*dst)?;
+                input(*arg)?;
+                if !matches!(
+                    symbol.get_id(),
+                    Symbol::EXP_ID
+                        | Symbol::LOG_ID
+                        | Symbol::SIN_ID
+                        | Symbol::COS_ID
+                        | Symbol::SQRT_ID
+                        | Symbol::ABS_ID
+                        | Symbol::CONJ_ID
+                ) {
+                    return Err(format!("Unsupported builtin at instruction {position}"));
+                }
+            }
+            Instr::ExternalFun(dst, function, args) => {
+                output(*dst)?;
+                let callee = callees
+                    .get(*function)
+                    .ok_or_else(|| format!("Invalid function index at instruction {position}"))?;
+                if callee.constant_index.is_some()
+                    || callee
+                        .body
+                        .as_ref()
+                        .is_some_and(|body| body.param_count != args.len())
+                {
+                    return Err(format!("Invalid function call at instruction {position}"));
+                }
+                for &arg in args {
+                    input(arg)?;
+                }
+            }
+            Instr::IfElse(condition, target) => {
+                input(*condition)?;
+                branch(target.0)?;
+            }
+            Instr::Goto(target) => branch(target.0)?,
+            Instr::Label(label) => {
+                if label.0 != position {
+                    return Err(format!("Invalid label at instruction {position}"));
+                }
+            }
+            Instr::Join(dst, condition, yes, no) => {
+                output(*dst)?;
+                input(*condition)?;
+                input(*yes)?;
+                input(*no)?;
+            }
+        }
+    }
+    Ok(())
+}
