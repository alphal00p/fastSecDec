+use super::*;
+use crate::{atom::EvaluationInfo, domains::float::Float, function, parse, symbol};
+
+#[test]
+fn fallible_mapping_preserves_values_precision_and_shared_bodies() {
+    let x = parse!("fallible_map::x");
+    let gamma = crate::transcendental::gamma();
+    let roots = [
+        parse!("fallible_map::outer(fallible_map::x)"),
+        gamma.call(Atom::num((3, 2))) + &x,
+    ];
+    let exact = Atom::evaluator_multiple(&roots, std::slice::from_ref(&x))
+        .add_function_with_options(
+            symbol!("fallible_map::inner"),
+            vec![symbol!("fallible_map::z")],
+            parse!("fallible_map::z^2+2"),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .add_function_with_options(
+            symbol!("fallible_map::outer"),
+            vec![symbol!("fallible_map::y")],
+            parse!("fallible_map::inner(fallible_map::y)+1/3"),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    let mut old = exact.clone().map_coeff(&|c| c.re.to_f64());
+    let mut mapped = exact
+        .clone()
+        .try_map_coeff_with_prec(&|c| c.re.to_f64(), 53)
+        .unwrap();
+    assert_eq!(mapped.get_output_len(), 2);
+    let mut shared = 0;
+    for (source, target) in exact.external_fns.iter().zip(&mapped.external_fns) {
+        if let Some(body) = &source.body {
+            shared += 1;
+            assert!(Arc::ptr_eq(body, target.body.as_ref().unwrap()));
+        }
+        assert!(target.stack.is_empty());
+    }
+    assert_eq!(shared, 2);
+    for point in [0.25, 0.75] {
+        let mut expected = [0.0; 2];
+        let mut actual = [0.0; 2];
+        old.evaluate(&[point], &mut expected);
+        mapped.evaluate(&[point], &mut actual);
+        assert_eq!(actual, expected);
+        assert!((actual[0] - (point * point + 2.0 + 1.0 / 3.0)).abs() < 1e-14);
+    }
+    for bits in [128, 256] {
+        let coefficient = |c: &Complex<Rational>| c.re.to_multi_prec_float(bits);
+        let mut old = exact.clone().map_coeff_with_prec(&coefficient, bits);
+        let mut mapped = exact
+            .clone()
+            .try_map_coeff_with_prec(&coefficient, bits)
+            .unwrap();
+        let point = [Float::with_val(bits, 0.25)];
+        let mut expected = vec![Float::with_val(bits, 0); 2];
+        let mut actual = expected.clone();
+        old.evaluate(&point, &mut expected);
+        mapped.evaluate(&point, &mut actual);
+        assert_eq!(actual, expected);
+    }
+}
+
+#[test]
+fn fallible_mapping_rejects_complex_fixed_gamma_in_a_real_domain() {
+    let x = parse!("fallible_gamma::x");
+    let expression = crate::transcendental::gamma().call(Atom::one() + Atom::i()) + &x;
+    let exact = expression
+        .evaluator(std::slice::from_ref(&x))
+        .build()
+        .unwrap();
+    assert!(
+        exact
+            .external_fns
+            .iter()
+            .any(|f| f.constant_index.is_some())
+    );
+    let error = exact
+        .clone()
+        .try_map_coeff_with_prec(&|c| c.re.to_f64(), 53)
+        .unwrap_err();
+    assert!(!error.is_empty());
+    let coefficient = |c: &Complex<Rational>| Complex::new(c.re.to_f64(), c.im.to_f64());
+    let mut old = exact.clone().map_coeff(&coefficient);
+    let mut mapped = exact.try_map_coeff_with_prec(&coefficient, 53).unwrap();
+    let point = [Complex::new(0.25, 0.0)];
+    let expected = old.evaluate_single(&point);
+    let actual = mapped.evaluate_single(&point);
+    assert!(actual.re.is_finite() && actual.im.is_finite());
+    assert_ne!(actual.im, 0.0);
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn fallible_mapping_checks_callbacks_inside_native_bodies() {
+    let callback = symbol!(
+        "fallible_callbacks::complex_only",
+        eval = EvaluationInfo::new()
+            .register(|args: &[Complex<f64>]| { args[0] + Complex::new(1.0, 0.0) })
+    );
+    let x = parse!("fallible_callbacks::x");
+    let wrapper = symbol!("fallible_callbacks::wrapper");
+    let exact = function!(wrapper, &x)
+        .evaluator(std::slice::from_ref(&x))
+        .add_function_with_options(
+            wrapper,
+            vec![symbol!("fallible_callbacks::y")],
+            function!(callback, parse!("fallible_callbacks::y")),
+            FunctionRegistrationOptions::new().inlining(InliningPolicy::Never),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    assert!(exact.external_fns.iter().any(|f| f.body.is_some()));
+    let error = exact
+        .clone()
+        .try_map_coeff_with_prec(&|c| c.re.to_f64(), 53)
+        .unwrap_err();
+    assert!(error.contains("complex_only"), "{error}");
+    assert!(error.contains("implementation"), "{error}");
+    // The pre-existing mapping API still permits deferred callback admission.
+    let old = exact.clone().map_coeff(&|c| c.re.to_f64());
+    assert!(
+        old.external_fns
+            .iter()
+            .any(|f| { f.constant_index.is_none() && f.body.is_none() && f.imp.is_none() })
+    );
+    let mut mapped = exact
+        .try_map_coeff_with_prec(&|c| Complex::new(c.re.to_f64(), c.im.to_f64()), 53)
+        .unwrap();
+    assert_eq!(
+        mapped.evaluate_single(&[Complex::new(2.0, 3.0)]),
+        Complex::new(3.0, 3.0)
+    );
+}
