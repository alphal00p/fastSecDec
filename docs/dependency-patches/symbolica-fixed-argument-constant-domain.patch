+#[cfg(test)]
+mod constant_conversion_tests {
+    use crate::{
+        atom::{AtomCore, EvaluationInfo},
+        domains::float::{Complex, ErrorPropagatingFloat, Float, RealLike},
+        parse, symbol,
+    };
+
+    #[test]
+    fn fixed_argument_constant_converts_from_multiprecision_to_error_tracking() {
+        let function = symbol!(
+            "fixed_constant_conversion::square",
+            eval = EvaluationInfo::new().register(|args: &[Complex<Float>]| &args[0] * &args[0])
+        );
+        let expression = function.call(3) + parse!("x");
+        let mut evaluator = expression
+            .evaluator(&[parse!("x")])
+            .build()
+            .unwrap()
+            .map_coeff(&|coefficient| {
+                ErrorPropagatingFloat::<f64>::new(coefficient.re.to_f64(), 15.0)
+            });
+        let value = evaluator.evaluate_single(&[ErrorPropagatingFloat::new(0.5, 15.0)]);
+        assert_eq!(value.to_f64(), 9.5);
+        assert!(value.get_absolute_error().is_finite());
+        assert!(value.get_absolute_error() > 0.0);
+    }
+}
