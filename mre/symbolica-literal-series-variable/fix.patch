+    #[test]
+    fn series_expansion_variables_are_literal() {
+        use crate::{id::Pattern, transcendental::TranscendentalFunctions};
+
+        let plain = symbol!("series_literal::x");
+        let underscored = symbol!("series_literal::x_");
+        let f = symbol!("series_literal::f");
+        for point in [0, 1] {
+            for expression in [
+                Atom::var(plain).gamma(),
+                f.call(&[Atom::one() + Atom::var(plain), Atom::var(plain).sin()][..]),
+            ] {
+                let renamed = expression
+                    .replace(Pattern::Literal(Atom::var(plain)))
+                    .with(Pattern::Literal(Atom::var(underscored)));
+                let expected = expression.series(plain, point, 2).unwrap().to_atom();
+                assert!(!expected.is_zero());
+                let expected = expected
+                    .replace(Pattern::Literal(Atom::var(plain)))
+                    .with(Pattern::Literal(Atom::var(underscored)));
+                assert_eq!(
+                    renamed.series(underscored, point, 2).unwrap().to_atom(),
+                    expected
+                );
+            }
+        }
+        assert_eq!(
+            Atom::var(underscored)
+                .gamma()
+                .series(underscored, 0, 0)
+                .unwrap()
+                .to_atom(),
+            Atom::var(underscored).pow(-1) - Atom::var(crate::transcendental::euler_gamma())
+        );
+    }
