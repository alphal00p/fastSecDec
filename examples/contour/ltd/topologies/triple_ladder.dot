// 1912.09291v2: 3L4P.K1. Prepared fixture; no three-loop generation gate yet.
digraph ltd_triple_ladder {
  ext0 [style=invis]; ext1 [style=invis];
  ext2 [style=invis]; ext3 [style=invis];
  p1 -> ext0 [id=0, particle="phi"];
  p2 -> ext1 [id=1, particle="phi"];
  p3 -> ext2 [id=2, particle="phi"];
  p4 -> ext3 [id=3, particle="phi"];
  bottom_left -> p2 [id=4, particle="phi", lmb_id=0];
  p1 -> top_left [id=5, particle="phi"];
  p2 -> p1 [id=6, particle="phi"];
  top_left -> bottom_left [id=7, particle="phi"];
  bottom_right -> bottom_left [id=8, particle="phi", lmb_id=1];
  top_left -> top_right [id=9, particle="phi"];
  top_right -> bottom_right [id=10, particle="phi"];
  p3 -> bottom_right [id=11, particle="phi", lmb_id=2];
  p4 -> p3 [id=12, particle="phi"];
  top_right -> p4 [id=13, particle="phi"];
}
