digraph self_energy_3loop {
  graph [label="self_energy_3loop"];
  ext0 [style=invis];
  ext1 [style=invis];
  v1; v2; v3; v4; v5;

  ext0 -> v1 [id=0, particle="phi"];
  v5 -> ext1 [id=1, particle="phi"];

  v1 -> v2 [id=2, particle="phi"];
  v2 -> v3 [id=3, particle="phi"];
  v3 -> v4 [id=4, particle="phi"];
  v4 -> v5 [id=5, particle="phi"];
  v1 -> v3 [id=6, particle="phi"];
  v2 -> v4 [id=7, particle="phi"];
  v3 -> v5 [id=8, particle="phi"];
}
