digraph triangle_numerator {
  graph [
    label="triangle_numerator",
    num="2*gammalooprs::K(0,spenso::mink(4,mu))*gammalooprs::P(1,spenso::mink(4,mu))"
  ];
  ext0 [style=invis];
  ext1 [style=invis];
  ext2 [style=invis];
  v1; v2; v3;

  ext0 -> v1 [id=0, particle="phi"];
  v2 -> ext1 [id=1, particle="phi"];
  v3 -> ext2 [id=2, particle="phi"];

  v1 -> v2 [id=3, particle="phi"];
  v2 -> v3 [id=4, particle="phi"];
  v3 -> v1 [id=5, particle="phi", lmb_id=0];
}
