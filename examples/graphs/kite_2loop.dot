digraph kite_2loop {
  graph [label="kite_2loop"];
  ext0 [style=invis];
  ext1 [style=invis];
  v1; v2; v3; v4;

  ext0 -> v1 [id=0, particle="phi"];
  v4 -> ext1 [id=1, particle="phi"];

  v1 -> v2 [id=2, particle="phi"];
  v2 -> v4 [id=3, particle="phi"];
  v1 -> v3 [id=4, particle="phi"];
  v3 -> v4 [id=5, particle="phi"];
  v2 -> v3 [id=6, particle="phi"];
}
